# Copiá este archivo a .env y completá tus valores. .env no se commitea.

# Proveedor del LLM (por ahora solo anthropic; gemini y ollama, para comparar en la fase 6)
LLM_PROVIDER=anthropic
# Vacío usa claude-opus-5-5. Otras opciones: claude-sonnet-5-5, claude-haiku-5-5
LLM_MODEL=
# Cuánto razona el modelo: low, medium, high, xhigh o max (más alto = más caro y lento)
LLM_ESFUERZO=medium

# Proveedor y modelo de embeddings (para buscar_tomas)
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=

# Claves (solo la del proveedor que uses)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Transcripción local con faster-whisper: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_IDIOMA=es
# Palabras que Whisper suele errar (se le pasan como contexto inicial)
WHISPER_VOCABULARIO=prompt, deck, sprint

# Límites del agente
AGENTE_MAX_PASOS=15
# Reintentos ante errores de red, 429 y 5xx (con backoff exponencial)
LLM_MAX_REINTENTOS=3
# Veces que el modelo puede corregir una salida que no pasó la validación
LLM_MAX_CORRECCIONES=3

# Carpeta para la caché de análisis por hash de clip
CACHE_DIR=.cache
